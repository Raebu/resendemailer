{
  "name": "gibp-mail",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Phone-primary, local-first multi-account email client powered by Resend",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch src/server/index.ts\"",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "android:add": "npm run build && npx cap add android && bash scripts/apply-android-overlay.sh && npx cap sync android",
    "android:sync": "npm run build && bash scripts/apply-android-overlay.sh && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/background-runner": "^2.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "nanoid": "^5.1.6",
    "zod": "^4.1.11",
    "@capacitor/file-viewer": "^2.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
