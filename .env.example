# Optional legacy desktop direct-Resend mode.
# Android uses OAuth-first account connections and does not require this value.
RESEND_API_KEY=

# Local-only listener. Do not change to 0.0.0.0 unless you add authentication.
GIBP_MAIL_HOST=127.0.0.1
GIBP_MAIL_PORT=8768
GIBP_MAIL_UI_PORT=8767

# Local storage
GIBP_MAIL_DATA_DIR=~/.local/share/gibp-mail

# Optional legacy desktop identities for direct-Resend mode.
# Android discovers identities from every connected Resend account automatically.
# Format: Display Name <address>
GIBP_MAIL_IDENTITIES=

# Poll interval; minimum enforced value is 15 seconds.
GIBP_MAIL_SYNC_SECONDS=45

# Optional: maximum attachment bytes downloaded per file (default 25 MiB)
GIBP_MAIL_MAX_ATTACHMENT_BYTES=26214400

# Optional: enables the phone-primary replica receiver on this PC.
# Generate a long random value and configure the same token in the Android app.
# Keep the Node listener on 127.0.0.1; expose it privately with Tailscale Serve HTTPS.
GIBP_REPLICA_TOKEN=
